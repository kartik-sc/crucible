# =============================================================================
# CRUCIBLE — environment template. Copy to .env and fill. NEVER commit .env.
# Keys are POOLS (comma-separated) of LEGITIMATE accounts, one per teammate,
# rotated by the Model Gateway on 429/5xx. Groq limits are per-ORG, so three
# separate accounts = real headroom; extra keys on one account do nothing.
# =============================================================================

# ---- Builder : Groq, Qwen3-32B (temp 0.2) --------------------------------
# 3 teammates' Groq accounts. VERIFY the exact model slug in Groq's console.
GROQ_API_KEYS=gsk_REPLACE_1,gsk_REPLACE_2,gsk_REPLACE_3
GROQ_BUILDER_MODEL=qwen3-32b

# ---- Breaker swarm : Google AI Studio, Gemma 4 (temp 0.8-1.0) ------------
# 3 teammates' AI Studio projects. VERIFY the exact Gemma 4 slug + per-project
# RPM/concurrency in the AI Studio rate-limit console (this is the #1 unknown).
AISTUDIO_API_KEYS=AIza_REPLACE_1,AIza_REPLACE_2,AIza_REPLACE_3
AISTUDIO_BREAKER_MODEL=gemma-4-REPLACE

# ---- Factual verifier : NLI entailment (NOT an LLM opinion) --------------
HF_API_TOKEN=hf_REPLACE
NLI_MODEL=MoritzLaurer/deberta-v3-large-mnli-fever-anli-ling-wanli

# ---- Retrieval for the factual domain (defense evidence) -----------------
TAVILY_API_KEY=tvly_REPLACE          # or swap for BRAVE_API_KEY

# ---- Services ------------------------------------------------------------
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000  # set to the Render URL in prod (Next.js only exposes NEXT_PUBLIC_*)
CORS_ORIGINS=http://localhost:3000,https://REPLACE-vercel-prod-origin.vercel.app   # comma-separated exact origins (local + Vercel prod)
VERCEL_PROJECT_SLUG=crucible               # preview deploys <project>-*-<team>.vercel.app are allowed by regex
VERCEL_TEAM_SLUG=REPLACE-team-slug         # Vercel scope slug; blank = no preview origins allowed
CRUCIBLE_AGENTS=fake                       # fake = scripted agents, no keys; real = everything real
FAKE_DELAY_SEC=0.4                         # pacing of fake agents so the arena animates

# ---- Per-seam real switches (local bring-up; default fake) ---------------
# Turn one seam real at a time. Fake fallbacks come from a planted demo artifact,
# so a real builder is checked against a spec-matched scenario. Needs keys above.
USE_REAL_BUILDER=0                         # 1 = real Builder (Groq via DevGateway)
USE_REAL_BREAKERS=                         # comma list of roles, e.g. boundary
USE_REAL_PYEXEC=0                          # 1 = PyExec actually runs the artifact in the sandbox
USE_REAL_NLI=0                             # 1 = NLI entailment for factual claims
DEMO_ARTIFACT=                             # demo key (code|lru|math|reasoning|factual); blank = first for the domain
SEED_FLAWED=0                              # with USE_REAL_BUILDER=1: seed v0 from the planted flaw so the real builder patches a real landed break

# ---- Loop constants (deterministic; override only with reason) -----------
MAX_ROUNDS=4
MAX_ATTACKS_PER_BREAKER=4
BUILDER_TEMPERATURE=0.2
BREAKER_TEMPERATURE=0.9
SANDBOX_TIMEOUT_SEC=2
VERIFY_TIMEOUT_SEC=8                       # router ceiling per verdict -> indeterminate
BREAKER_ROLES=boundary,numeric_type,spec_gap,factual   # cut order: drop roles here
