# CRUCIBLE frontend — environment template. Copy to .env.local (gitignored).
#
# The browser calls the Render backend's /run directly. Next.js only exposes
# variables prefixed NEXT_PUBLIC_ to client code, so the API URL MUST use that
# prefix — the root .env.example's WEB_PUBLIC_API_URL never reaches the browser
# (see docs/contract-asks.md, issue #1).
#
# Leave this UNSET to run the built-in client-side mock (the demo default).
# Set it to the Render URL to stream from the live backend — no code change.

# NEXT_PUBLIC_API_URL=https://crucible-api.onrender.com

# Absolute site origin, used for Open Graph / Twitter card URLs (metadataBase).
# Defaults to http://localhost:3000; set to the Vercel URL in production.

# NEXT_PUBLIC_SITE_URL=https://crucible.vercel.app
